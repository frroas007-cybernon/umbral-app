# Copia este archivo a "keystore.properties" (sin .example) en esta misma carpeta,
# y completa los valores reales. keystore.properties está en .gitignore — nunca lo subas a git.
#
# storeFile es la ruta al archivo .jks, relativa a esta carpeta (android/).
# Si guardas el .jks fuera del proyecto (recomendado), usa una ruta absoluta, ej:
# storeFile=/Users/franciscoroasanmartin/keys/umbral-release-key.jks

storeFile=../umbral-release-key.jks
storePassword=TU_PASSWORD_DEL_KEYSTORE
keyAlias=umbral
keyPassword=TU_PASSWORD_DE_LA_CLAVE
